# Server
PORT=
ENVIRONMENT=
# Grace period for draining in-flight requests on SIGTERM (Railway redeploys).
# Optional, default 10s.
SHUTDOWN_TIMEOUT=
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted for
# c.ClientIP(). Leave empty behind a single edge proxy (Railway) - empty means
# "trust none", which is the safe default.
TRUSTED_PROXIES=

# Database
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=
# TLS mode for the MySQL connection: empty/false (none - fine over Railway
# private networking), true, skip-verify, or preferred. Use true when
# connecting over a public MySQL proxy.
DB_TLS=
# Connection pool sizing. Optional (defaults 100 / 10). Lower DB_MAX_OPEN_CONNS
# on managed plans with tight connection limits (e.g. 20).
DB_MAX_OPEN_CONNS=
DB_MAX_IDLE_CONNS=

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRY=
JWT_REFRESH_EXPIRY=

# Admin bootstrap - creates the first admin on a fresh deploy (every
# admin-management route needs an existing admin session, so there's no other
# way to make the first one). Opt-in: leave email+password empty to disable.
# Idempotent - once that admin exists this does nothing, so it's safe to keep
# set across redeploys. Change the password via the admin API afterwards.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=

# OAuth
GOOGLE_OAUTH_ID=
GOOGLE_OAUTH_SECRET=
OAUTH_CALLBACK_URL=

# Midtrans (Sandbox)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_SANDBOX=

# R2 (Cloudflare)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_REGION=
R2_PUBLIC_BASE_URL=

# CORS - comma-separated list of allowed origins (frontend + admin)
CORS_ORIGINS=

# Cookies - SameSite=None is hardcoded (frontend/admin/backend are on
# different domains in prod), which requires Secure. localhost is treated as
# a secure context by modern browsers so this works fine over plain http in
# dev too; only flip to false if your browser is rejecting the cookies.
COOKIE_SECURE=
